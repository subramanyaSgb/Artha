<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <!-- Foreground is the vector path "A" mark so the geometry stays identical
         across mask shapes (round / squircle / square) and screen densities.
         The earlier PNG-bitmap foreground was off-center on the round mask. -->
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!-- Monochrome (themed icons, Android 13+) uses the same vector. -->
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
