<?xml version="1.0" encoding="utf-8"?>
<!--
    Phase 1: no cloud/device transfer of user data. Phase 5 will revisit
    with explicit user-initiated, encrypted export.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
