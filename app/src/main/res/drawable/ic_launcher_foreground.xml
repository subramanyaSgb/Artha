<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Adaptive-icon foreground. The launcher mask crops the outer 22% of the
         108×108 canvas, leaving a 66×66 "safe zone" centered at (54, 54). The
         "A" mark below sits inside that zone (x: 36..72, y: 36..72) so it stays
         optically centered on round, squircle, and rectangular masks. -->
    <path
        android:pathData="M 38 72 L 54 36 L 70 72"
        android:strokeColor="@color/ic_launcher_foreground"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M 44 60 L 64 60"
        android:strokeColor="@color/ic_launcher_foreground"
        android:strokeWidth="6"
        android:strokeLineCap="round" />
</vector>
