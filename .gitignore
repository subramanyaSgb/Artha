# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches
.idea/modules.xml
.idea/navEditor.xml

# Keystore files
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# KSP / KAPT
.ksp/
.kapt/

# macOS
.DS_Store

# Windows
Thumbs.db
desktop.ini

# VS Code (workspace-local; keep extensions.json if you want to share)
.vscode/

# MCP tool scratch dirs (e.g. code-review-graph)
.code-review-graph/

# Output / artifact directories
out/

# Personal documents that occasionally land in docs/ during testing
docs/*.zip
docs/*.pdf

# Raw bank-statement source files — personal financial data. The Python
# importer scripts in docs/Bank statement/ are tracked, but never the data.
docs/Bank statement/*.xlsx
docs/Bank statement/*.xls
docs/Bank statement/*.pdf
docs/Bank statement/__pycache__/

# Generated bundled-import asset — contains every imported transaction (3,900+
# rows of personal financial data). Re-generate locally with:
#   python "docs/Bank statement/import_to_artha.py" --export-json
# before each APK build that needs it.
app/src/main/assets/seed/bank_import.json

# Emulator / SDK installers and other large binaries that have no business
# living in git history. GitHub rejects pushes containing files over 100 MB.
*.exe
*.msi
*.dmg
*.iso
*.7z
*.tar.gz
*.tgz
docs/Artha-handoff/artha/project/genymotion-*.exe
