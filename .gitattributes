# Force LF for all source files. Prevents autocrlf-on-Windows from breaking
# ktlint/Spotless after a fresh checkout.
*           text=auto eol=lf

# Binary files
*.jar       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.apk       binary
*.aab       binary
*.keystore  binary
*.jks       binary

# gradlew is a shell script — must stay LF
gradlew     text eol=lf
*.sh        text eol=lf

# gradlew.bat and other Windows files — keep CRLF
gradlew.bat text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf
